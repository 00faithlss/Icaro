#pragma code_page(65001)
#include <winver.h>

IDI_ICARO ICON "@ICARO_ICON@"

1 VERSIONINFO
FILEVERSION @ICARO_NUMERIC@
PRODUCTVERSION @ICARO_NUMERIC@
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Icaro Launcher\0"
            VALUE "FileVersion", "@ICARO_VERSION@\0"
            VALUE "ProductName", "Icaro Launcher\0"
            VALUE "ProductVersion", "@ICARO_VERSION@\0"
            VALUE "OriginalFilename", "launcher.exe\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
